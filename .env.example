# Documentation only. The application does NOT automatically load this file.
# Use GitHub repository Secrets for these four values. Do not use your normal password.
SMTP_USER=your-smtp-login
SMTP_PASSWORD=your-app-password-or-smtp-key
MAIL_FROM=your-verified-sender@example.com
MAIL_TO=your-own-inbox@example.com
# A fifth GitHub Secret protects article text in temporary public-repository artifacts.
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
DIGEST_KEY=64-random-hex-characters

# GitHub repository Variables (not Secrets); Gmail defaults:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# Brevo alternative: smtp-relay.brevo.com / 465 / ssl
